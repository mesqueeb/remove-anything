{
  "name": "remove-anything",
  "version": "2.1.1",
  "description": "Remove any prop (eg. `undefined`) from an object",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint ./src",
    "build": "del-cli dist && tsc",
    "release": "pnpm run lint && pnpm run build && pnpm test && bumpp --no-push && pnpm publish --no-git-checks && git push --follow-tags && gh release create $(git describe --tags --abbrev=0) --generate-notes"
  },
  "dependencies": {
    "is-what": "^5.5.0"
  },
  "devDependencies": {
    "@cycraft/eslint": "^0.4.7",
    "@cycraft/tsconfig": "^0.1.2",
    "bumpp": "^12.3.0",
    "del-cli": "^7.0.0",
    "vitest": "^5.0.1"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "remove",
    "remove-prop",
    "remove-anything",
    "remove-undefined"
  ],
  "author": "Luca Ban - Mesqueeb (https://cycraft.co)",
  "funding": "https://github.com/sponsors/mesqueeb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mesqueeb/remove-anything.git"
  },
  "homepage": "https://github.com/mesqueeb/remove-anything#readme",
  "bugs": "https://github.com/mesqueeb/remove-anything/issues",
  "packageManager": "pnpm@11.27.0"
}
